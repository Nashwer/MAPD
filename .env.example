# Gemini's OpenAI-compatible endpoint. Never commit the real .env file.
MAPD_TEACHER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MAPD_TEACHER_API_KEY=
MAPD_TEACHER_MODEL=gemini-3.8-flash
MAPD_TEACHER_THINKING_MODE=low
MAPD_TEACHER_CONCURRENCY=8
MAPD_SYNTHESIS_WORKERS=8
# A concurrent run can exceed the budget cap by at most one in-flight request batch.
# Gemini 3.8 Flash introductory standard prices through 2026-12-31.
MAPD_TEACHER_INPUT_PRICE_PER_MILLION=0.75
MAPD_TEACHER_OUTPUT_PRICE_PER_MILLION=3.75
MAPD_TEACHER_BUDGET_USD=5.0
MAPD_TEACHER_BUDGET_LEDGER=artifacts/teacher_usage_gemini38_30pct_seed42.jsonl

# Optional prepared subset used by retrieval/protocol commands.
MAPD_TRAIN_DATA=data/training/mapd_train_30pct_seed42.jsonl
MAPD_PROTOCOL_RUN_TAG=gemini38_30pct_seed42

# Optional remote retrieval endpoint implementing POST /retrieve.
MAPD_RETRIEVER_URL=http://127.0.0.1:8000/retrieve

# Retrieval backend. Keep sqlite-fts5 until the compressed E5 build finishes,
# then switch to e5-ivfpq and restart the retrieval service.
MAPD_RETRIEVER_BACKEND=sqlite-fts5
MAPD_E5_DOCSTORE=data/wiki18/index/wiki18.sqlite3
MAPD_E5_INDEX=data/wiki18/e5_ivfpq/wiki18_e5_ivfpq.faiss
MAPD_E5_MODEL=intfloat/e5-base-v2
MAPD_E5_DEVICE=auto
MAPD_E5_BATCH_SIZE=128
MAPD_E5_NLIST=4096
MAPD_E5_PQ_M=96
MAPD_E5_PQ_NBITS=8
MAPD_E5_TRAIN_SIZE=262144
MAPD_E5_NPROBE=64
MAPD_E5_CHECKPOINT_EVERY=1000000
MAPD_E5_THREADS=16

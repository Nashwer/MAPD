# DeepSeek's OpenAI-compatible endpoint. Never commit the real .env file.
MAPD_TEACHER_BASE_URL=https://api.deepseek.com
MAPD_TEACHER_API_KEY=
MAPD_TEACHER_MODEL=deepseek-flash
# Conservative process-resumable limit; USD 5 is about CNY 33.5.
MAPD_TEACHER_BUDGET_USD=5.0

# Optional remote retrieval endpoint implementing POST /retrieve.
MAPD_RETRIEVER_URL=http://127.0.0.1:8000/retrieve

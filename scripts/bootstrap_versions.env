# Repository-controlled inputs for rebuilding an ephemeral GPU server.
# Update this file together with requirements/server-bootstrap.txt and the
# selected runtime constraints file when the runtime stack changes.
# Repository defaults.  Every value remains overridable from the environment so
# the same revision can be deployed on compatible shared hosts without editing
# tracked files (for example CUDA 12.4 on the BUPT server).
MAPD_BOOTSTRAP_SCHEMA=${MAPD_BOOTSTRAP_SCHEMA:-6}
MAPD_RUNTIME_PROFILE=${MAPD_RUNTIME_PROFILE:-cu124-torch26-vllm085}
MAPD_VERL_REF=${MAPD_VERL_REF:-v0.5.0}
MAPD_MODEL_ID=${MAPD_MODEL_ID:-Qwen/Qwen3-1.7B}
MAPD_PYTHON_VERSION=${MAPD_PYTHON_VERSION:-3.12}
MAPD_NUMPY_VERSION=${MAPD_NUMPY_VERSION:-1.26.4}
MAPD_CUDA_SERIES=${MAPD_CUDA_SERIES:-12.4}
MAPD_TORCH_VERSION=${MAPD_TORCH_VERSION:-2.6.0}
MAPD_TORCHVISION_VERSION=${MAPD_TORCHVISION_VERSION:-0.21.0}
MAPD_TORCHAUDIO_VERSION=${MAPD_TORCHAUDIO_VERSION:-2.6.0}
MAPD_VLLM_VERSION=${MAPD_VLLM_VERSION:-0.8.5.post1}
MAPD_TRANSFORMERS_VERSION=${MAPD_TRANSFORMERS_VERSION:-4.53.2}
MAPD_TORCH_INDEX_URL=${MAPD_TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu124}
MAPD_QA_REVISION=${MAPD_QA_REVISION:-b7d80abfee334a7a91cb377544f09180d58b34f6}
MAPD_WIKI18_REVISION=${MAPD_WIKI18_REVISION:-69c1c00ffe7c5554c68d8548355cb22e46aabc51}
MAPD_WIKI18_E5_REVISION=${MAPD_WIKI18_E5_REVISION:-a4d31160a035f30764604f4827cd8f1d0315eb86}

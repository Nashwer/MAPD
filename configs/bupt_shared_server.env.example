# Copy the non-secret settings you need into the repository-root .env file.
# This profile targets the inspected BUPT shared host owned by user qjx.

MAPD_SHARED_SERVER=1
MAPD_STORAGE_ROOT=/data4/team2/qjx
MAPD_CACHE_ROOT=/data4/team2/qjx/cache
MAPD_MODEL_ROOT=/data4/team2/qjx/models
VERL_ROOT=/data4/team2/qjx/verl
VERL_VENV=/data4/team2/qjx/verl/.venv
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/data4/team2/qjx/cache/huggingface
UV_CACHE_DIR=/data4/team2/qjx/cache/uv
PIP_CACHE_DIR=/data4/team2/qjx/cache/pip
TMPDIR=/data4/team2/qjx/tmp

# The host provides CUDA 12.4 and ports 8000/18080 were occupied when profiled.
MAPD_CUDA_SERIES=12.4
CUDA_HOME=/usr/local/cuda-12.4
MAPD_RETRIEVER_HOST=127.0.0.1
MAPD_RETRIEVER_PORT=28180
MAPD_RETRIEVER_URL=http://127.0.0.1:28180/retrieve
MAPD_RETRIEVER_HEALTH_URL=http://127.0.0.1:28180/health

# Keep the persistent retriever on CPU so it does not reserve a shared GPU.
MAPD_RETRIEVER_BACKEND=e5-ivfpq
MAPD_E5_DOCSTORE=data/wiki18/index/wiki18.sqlite3
MAPD_E5_INDEX=data/wiki18/e5_ivfpq/wiki18_e5_ivfpq.faiss
MAPD_E5_MODEL=intfloat/e5-base-v2
MAPD_E5_DEVICE=cpu
MAPD_E5_NPROBE=64
MAPD_E5_THREADS=32

# Set this immediately before a GPU job, after inspecting nvidia-smi.  Do not
# leave an index here permanently: availability on this host changes over time.
# MAPD_GPU_DEVICES=2
MAPD_GPU_MAX_USED_MIB=1024
MAPD_GPU_MAX_UTILIZATION=20

# The tested relay is stable at five concurrent teacher requests.
MAPD_TEACHER_CONCURRENCY=5
MAPD_SYNTHESIS_WORKERS=5

# Add the provider values locally; never commit the real key.
MAPD_TEACHER_BASE_URL=https://gpt-load.beatdot.org/v1
MAPD_TEACHER_API_KEY=
MAPD_TEACHER_MODEL=gemini-3.8-flash-high
MAPD_TEACHER_THINKING_MODE=high
